# Copy this file to .streamlit/secrets.toml for local development.
# On Streamlit Community Cloud, add the same values in App settings → Secrets.
# Use the service_role key because Streamlit keeps secrets on the Python server.

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-supabase-service-role-key"
SUPABASE_TABLE = "expert_responses"
SUPABASE_ASSIGNMENTS_TABLE = "questionnaire_assignments"
SUPABASE_SCHEMA = "public"

# Protects the administrator dashboard at ?admin=1. Prefer a long random value.
ADMIN_PASSWORD = "replace-with-a-strong-random-password"

# Optional alternative: store only a lowercase SHA-256 password digest.
# ADMIN_PASSWORD_SHA256 = "..."

# A relationship is flagged until it has this many usable (non-Cannot-Assess)
# evaluations from completed respondents.
MIN_EVALUATIONS_PER_RELATIONSHIP = 3
